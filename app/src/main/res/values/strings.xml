<?xml version="1.0" encoding="utf-8"?>
<!-- Default locale = English: automatic fallback for unsupported device languages.
     Rule of the fake-editor design: "code" (JSON keys, filenames, terminal errors,
     // comments) stays English everywhere; only chrome, accessibility text and
     user-facing weather DATA values are localized. -->
<resources>
    <string name="app_name" translatable="false">tweather</string>

    <!-- Bottom navigation -->
    <string name="nav_explorer">Explorer</string>
    <string name="nav_search">Search</string>
    <string name="nav_settings">Settings</string>
    <string name="nav_logs">Logs</string>

    <!-- Chrome / status bars -->
    <string name="status_last_updated">Last Updated: %1$s</string>
