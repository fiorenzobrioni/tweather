<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis=0 on purpose: the widget never polls on its own — it is
     re-rendered whenever a fetch commits new data (weather-sync worker or the app
     in foreground), keeping the battery cost identical to notifications alone.
     targetCellHeight=3 so the default placement lands in the medium band the
     picker preview advertises (see WidgetRenderer's sizes map). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_tweather_medium"
    android:minWidth="110dp"
    android:minHeight="48dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="48dp"
    android:previewLayout="@layout/widget_tweather_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:configure="com.callbackdev.tweather.widget.WidgetConfigActivity"
    android:widgetFeatures="configuration_optional|reconfigurable" />
