<?xml version="1.0" encoding="utf-8"?>
<!-- The mockup tier: terminal window with header, prompt and 4 key/value lines.
     All texts and colors are bound at render time (theme-aware); RemoteViews
     constraint: dividers/guides are ImageViews, plain <View> is not whitelisted.
     fontFamily="monospace" (not JetBrains Mono) — see @style/WidgetBodyLine. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_fill" />

    <ImageView
        android:id="@+id/widget_bg_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- minHeight, not a fixed height: the title bar has to grow with the system
             font scale instead of clipping (same rule as the app's editor bars) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:singleLine="true"
                android:textSize="15sp" />

            <!-- The weather glyph lives in the title bar, not floating over the body:
                 down there it had to be given a permanent width reservation on every
                 line, and the values are worth more than the decoration.
                 Default font family on purpose — the color-emoji font must kick in. -->
            <TextView
                android:id="@+id/widget_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:importantForAccessibility="no"
                android:textSize="20sp" />
        </FrameLayout>

        <ImageView
            android:id="@+id/widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:paddingHorizontal="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:singleLine="true"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_guide"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_line1"
                        style="@style/WidgetBodyLine" />

                    <TextView
                        android:id="@+id/widget_line2"
                        style="@style/WidgetBodyLine" />

                    <TextView
                        android:id="@+id/widget_line3"
                        style="@style/WidgetBodyLine" />

                    <TextView
                        android:id="@+id/widget_line4"
                        style="@style/WidgetBodyLine" />
                </LinearLayout>
            </LinearLayout>

            <!-- The only control over the body, in the corner. minWidth/minHeight
                 rather than padding: the glyph stays 20sp while the tappable box
                 reaches the 48dp accessibility minimum, and the renderer gives the
                 bottom line the matching end margin so nothing hides under it. -->
            <TextView
                android:id="@+id/widget_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:fontFamily="monospace"
                android:gravity="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/widget_refresh_glyph"
                android:textSize="20sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
