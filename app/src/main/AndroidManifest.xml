<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Coarse only: city-level accuracy is plenty for weather (current_location.json) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Alert engine (Fase 9c); minSdk 33 = single runtime-request code path -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Fase 16f. Alarms do not survive a reboot and WorkManager's persistence does not
      extend to them, so without this the sky reminders would go quiet after a restart
      and nothing would say why. A normal permission, not a runtime one.

      Deliberately NOT here: SCHEDULE_EXACT_ALARM. The reminders are inexact by
      design (setAndAllowWhileIdle) — battery is a feature, and a sunset is not an
      alarm clock. That is also why the shortest selectable lead is 15 minutes.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tweather">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Tweather.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sky reminders (Fase 16f). exported=false: the system is exempt from the
             export check for the broadcasts it sends itself, and our own alarm intent
             is explicit, so nothing else can make this fire. -->
        <receiver
            android:name=".notifications.SkyAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Home widget (Fase 9d). exported=false: the system delivers APPWIDGET_*
             regardless, and it keeps our custom refresh action private. -->
        <receiver
            android:name=".widget.TweatherWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tweather_info" />
        </receiver>

        <!-- Optional widget configuration: pins one instance to a city. exported
             because the launcher starts it; it acts only on the appWidgetId it is
             handed, and reads nothing sensitive. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Tweather">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>
