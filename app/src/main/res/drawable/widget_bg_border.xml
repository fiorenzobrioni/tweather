<?xml version="1.0" encoding="utf-8"?>
<!-- The 1px terminal frame, Obsidian by default (see widget_bg_fill for why the
     color is baked in). Re-tinted with the theme's border color at render time and
     kept opaque even when the fill is faded, so the window edge stays crisp. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="1dp"
        android:color="#30363D" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>
